# 초안: PM이 .github/workflows/watch.yml로 옮겨 등록한다(워크플로 파일 푸시 권한 문제 회피).
name: watch
on:
  schedule:
    - cron: "0 23 * * *"   # 매일 KST 08:00 (UTC 23:00)
  workflow_dispatch: {}
permissions:
  contents: write
  pull-requests: write
jobs:
  watch:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-node@v4
        with:
          node-version: 22
      - name: run watch
        id: watch
        run: |
          set +e
          node research/tools/watch.mjs > watch-report.md
          echo "code=$?" >> "$GITHUB_OUTPUT"
          cat watch-report.md
      - name: open PR when changed or failed
        if: steps.watch.outputs.code == '2'
        env:
          GH_TOKEN: ${{ secrets.GITHUB_TOKEN }}
        run: |
          branch="watch/$(date -u +%Y%m%d)"
          git config user.name "watch-bot"
          git config user.email "watch-bot@users.noreply.github.com"
          git checkout -b "$branch"
          git add research/data/watch-state.json
          git commit -m "watch: 변경 감지 $(date -u +%F)" || true
          git push -u origin "$branch"
          gh pr create --title "감시: 변경 감지 $(date -u +%F)" --body-file watch-report.md --base main
      - name: save state on no change
        if: steps.watch.outputs.code == '0'
        run: echo "변경 없음, 상태 파일은 커밋하지 않음"
