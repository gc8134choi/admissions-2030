{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "electives.schema.json",
 "title": "electives (선택과목 현황) — research/data/electives-draft.json = portal/data/electives.json",
 "description": "학교별 현 2학년의 학기별 선택과목 인원. 학교는 places의 placeId로 연결한다. 한 학생이 pick(택n)개 과목을 고르므로 한 학기 인원 합계 = 현원 × pick이어야 한다(생성기가 검산). 화면은 사회·과학 선택 비중과 성향 한 줄을 보여 준다. 성향은 '선택 비중 기준 추정'이지 문과·이과 학생 수가 아니다. 사람 이름은 쓰지 않는다. 사용자 제공 자료에 '원문 미확인'은 쓰지 않는다.",
 "type": "object",
 "required": ["items"],
 "properties": {
  "guide": { "type": "object", "description": "'유불리 보는 법' 접이식 내용. 학교별 유불리를 단정하지 않는다", "properties": {
   "basis": { "type": "array", "description": "공식 근거 문장", "items": { "type": "object", "required": ["text"], "properties": { "text": { "type": "string" }, "source": { "type": "object", "properties": { "name": { "type": "string" }, "url": { "type": ["string", "null"] }, "kind": { "enum": ["official", "media"] } } } } } },
   "questions": { "type": "array", "description": "설명회에서 물어볼 질문", "items": { "type": "string" } } } },
  "items": { "type": "array", "items": { "type": "object", "required": ["placeId", "name", "status"], "properties": {
   "placeId": { "type": "string", "pattern": "^pl-\\d{3,}$" },
   "name": { "type": "string" },
   "grade": { "type": "string", "description": "대상 학년(예: 2학년)" },
   "headcount": { "type": ["integer", "null"], "minimum": 1, "description": "현원(명)" },
   "pick": { "type": ["integer", "null"], "minimum": 1, "description": "학생 1명이 고르는 과목 수(택n)" },
   "area": { "type": "string", "description": "과목 묶음 이름(예: 탐구)" },
   "asOf": { "type": ["string", "null"], "format": "date", "description": "자료 기준일" },
   "sourceKind": { "type": "string", "description": "자료 유형(예: 설명회 슬라이드, 학교 안내문)" },
   "status": { "enum": ["confirmed", "reported", "estimated"] },
   "sources": { "type": "array", "items": { "type": "object", "required": ["name"], "properties": { "name": { "type": "string" }, "url": { "type": ["string", "null"] } } } },
   "fileIds": { "type": "array", "items": { "type": "string" }, "description": "원본 사진·문서(files.json의 id). 있으면 portal/data/files.json에 있어야 한다" },
   "note": { "type": ["string", "null"] },
   "nullReason": { "type": ["string", "null"], "description": "자료가 없을 때 사유(terms가 비어 있으면 필수)" },
   "terms": { "type": "array", "items": { "type": "object", "required": ["label", "subjects"], "properties": {
    "label": { "type": "string", "description": "예: 2학년 1학기" },
    "subjects": { "type": "array", "minItems": 1, "items": { "type": "object", "required": ["name", "area", "count"], "properties": { "name": { "type": "string" }, "area": { "enum": ["사회", "과학"] }, "count": { "type": "integer", "minimum": 0 } } } } } } } } } }
 }
}
