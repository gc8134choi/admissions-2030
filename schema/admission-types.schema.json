{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "admission-types.schema.json",
 "title": "admission-types (전형 한눈에) — research/data/admission-types-draft.json = portal/data/admission-types.json",
 "description": "대입 전형 용어 설명(시점과 무관한 일반 설명). 전형별 모집 비중 수치는 시점이 있는 자료라 policy.json의 행(related.policyRows, 예: str-16~18)에 두고 화면이 거기서 읽는다(상태와 공식/매체 구분은 그 행의 status·sourceKind).",
 "type": "object",
 "required": ["seasons", "terms", "overview", "related"],
 "properties": {
  "seasons": { "type": "array", "items": { "type": "object", "required": ["id", "name", "when", "contains"], "properties": { "id": { "enum": ["susi", "jeongsi"] }, "name": { "type": "string" }, "when": { "type": "string" }, "contains": { "type": "array", "items": { "type": "string", "description": "terms[].id" } } } } },
  "terms": { "type": "array", "items": { "type": "object", "required": ["id", "name", "season", "what"], "properties": { "id": { "type": "string" }, "name": { "type": "string" }, "season": { "enum": ["susi", "jeongsi"] }, "what": { "type": "string" }, "caveat": { "type": ["string", "null"] }, "favors": { "type": ["string", "null"] } } } },
  "overview": { "type": "object", "required": ["columns", "rows"], "properties": { "columns": { "type": "array", "items": { "type": "string" } }, "rows": { "type": "array", "items": { "type": "array", "items": { "type": "string" } } } } },
  "related": { "type": "object", "required": ["policyRows"], "properties": { "policyRows": { "type": "array", "items": { "type": "string", "description": "policy.json 행 id" } }, "note": { "type": ["string", "null"] }, "briefing": { "type": ["string", "null"], "description": "연결된 설명회 노트 id" } } }
 }
}
