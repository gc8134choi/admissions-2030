{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "events.schema.json",
 "title": "events (일정)",
 "description": "policy.json 안에 섞여 있던 events[] 와 build-policy.mjs의 EVENTS 하드코딩을 독립 엔티티로 분리한다.",
 "type": "object",
 "required": [
  "id",
  "title",
  "stage",
  "start",
  "status",
  "sources",
  "checkedAt"
 ],
 "properties": {
  "id": {
   "type": "string",
   "pattern": "^ev-[a-z0-9-]+$"
  },
  "title": {
   "type": "string"
  },
  "stage": {
   "enum": [
    "elem",
    "mid",
    "hs-entry",
    "hs1",
    "hs2",
    "hs3",
    "csat",
    "susi",
    "jeongsi",
    "univ",
    "life"
   ]
  },
  "region": {
   "enum": [
    "national",
    "gyeonggi",
    "seoul",
    "school"
   ]
  },
  "audience": {
   "type": "array",
   "items": {
    "enum": [
     "common",
     "general",
     "science",
     "gifted",
     "private",
     "foreign",
     "international",
     "specialized",
     "meister",
     "grade3"
    ]
   },
   "description": "고입 유형 등 대상. 비면 common"
  },
  "learnerIds": {
   "type": "array",
   "items": {
    "type": "string"
   },
   "description": "비어 있으면 아래 연도 규칙으로 해석"
  },
  "entryYear": {
   "type": [
    "integer",
    "null"
   ]
  },
  "examYear": {
   "type": [
    "integer",
    "null"
   ]
  },
  "start": {
   "type": "string",
   "pattern": "^\\d{4}(-\\d{2}(-\\d{2})?)?$",
   "description": "YYYY | YYYY-MM | YYYY-MM-DD"
  },
  "end": {
   "type": "string"
  },
  "precision": {
   "enum": [
    "day",
    "month",
    "year"
   ]
  },
  "status": {
   "enum": [
    "confirmed",
    "reported",
    "estimated"
   ],
   "description": "확정/보도/추정. 화면 표시: confirmed는 표시 안 함, 나머지만 표시"
  },
  "sources": {
   "type": "array",
   "minItems": 1,
   "items": {
    "type": "object",
    "required": [
     "name",
     "kind"
    ],
    "properties": {
     "name": {
      "type": "string"
     },
     "url": {
      "type": "string",
      "format": "uri"
     },
     "kind": {
      "enum": [
       "official",
       "media",
       "school",
       "self"
      ]
     },
     "retrieved": {
      "type": "string",
      "format": "date"
     }
    }
   }
  },
  "checkedAt": {
   "type": "string",
   "format": "date"
  },
  "policyRef": {
   "type": "string"
  },
  "supersedes": {
   "type": "string"
  },
  "unverified": {
   "type": "boolean"
  }
 },
 "examples": [
  {
   "id": "ev-csat-2030",
   "title": "2030학년도 수능",
   "stage": "csat",
   "region": "national",
   "examYear": 2030,
   "start": "2029-11-15",
   "precision": "day",
   "status": "estimated",
   "sources": [
    {
     "name": "평가원 수능 홈페이지",
     "url": "https://www.suneung.re.kr/main.do?s=suneung",
     "kind": "official",
     "retrieved": "2026-10-25"
    }
   ],
   "checkedAt": "2026-10-25",
   "policyRef": "sch-12"
  },
  {
   "id": "ev-life-mid-grad-A",
   "title": "중학교 졸업",
   "stage": "life",
   "region": "school",
   "learnerIds": [
    "A"
   ],
   "start": "2026-12-18",
   "precision": "day",
   "status": "confirmed",
   "sources": [
    {
     "name": "사용자 제공",
     "kind": "self",
     "retrieved": "2026-10-25"
    }
   ],
   "checkedAt": "2026-10-25"
  }
 ]
}
